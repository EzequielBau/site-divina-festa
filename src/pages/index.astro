---
// Home. A indexação segue a configuração global (PUBLIC_ALLOW_INDEXING, DEC-030).
// A página de validação do Design System foi movida para /design-system.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import EventTypes from '../components/home/EventTypes.astro';
import KidsAndAdults from '../components/home/KidsAndAdults.astro';
import Gastronomy from '../components/home/Gastronomy.astro';
import SpaceAndStructure from '../components/home/SpaceAndStructure.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { site } from '../data/site';
import '../styles/home.css';
---

<BaseLayout
  title={`${site.business.name} — espaço de eventos e buffet em ${site.address.city}`}
  description={`Espaço de eventos e buffet no bairro ${site.address.neighborhood}, em ${site.address.city}: salão, área infantil, gastronomia própria, estacionamento privativo e equipe para festas infantis, eventos familiares, 15 anos e corporativos.`}
>
  <main>
    <Hero />
    <EventTypes />
    <KidsAndAdults />
    <Gastronomy />
    <SpaceAndStructure />
    <HowItWorks />
    <FinalCta />
  </main>
</BaseLayout>
