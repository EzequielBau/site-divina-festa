---
// Fechamento: principal ponto de decisão antes do rodapé. O botão leva ao formulário de proposta
// (a criar), por site.links.proposal; até lá o destino é provisório. O id #contato é o destino do
// item "Contato" do menu. O fallback para WhatsApp (DEC-032) pertence ao formulário, não a este botão.
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';
import { site } from '../../data/site';
---

<Section id="contato" tone="warm" class="cta home-section" aria-labelledby="cta-title">
  <Container class="cta__grid">
    <div class="cta__content">
      <Eyebrow>Planeje seu evento com o Divina</Eyebrow>
      <h2 id="cta-title">Conte-nos o que você está planejando</h2>
      <p class="text-large">
        Informe o tipo de evento, a data e o número aproximado de convidados. A partir dessas
        informações, podemos entender melhor o que você precisa e apresentar as opções mais
        adequadas.
      </p>
    </div>

    <div class="cta__action">
      <Button href={site.links.proposal}>Solicitar proposta</Button>
    </div>
  </Container>
</Section>

<style>
  .cta :global(.cta__grid) {
    display: grid;
    gap: var(--space-24);
  }

  .cta__content {
    display: grid;
    justify-items: start;
    gap: var(--space-12);
  }

  .cta__content :global(h2),
  .cta__content p {
    margin: 0;
  }

  .cta__content p {
    max-width: 38rem;
  }

  .cta__action {
    display: grid;
    justify-items: stretch;
    gap: var(--space-12);
  }

  @media (min-width: 40rem) {
    .cta__action {
      justify-items: start;
    }
  }

  /* Texto à esquerda, ação à direita, alinhados pelo centro. */
  @media (min-width: 56rem) {
    .cta :global(.cta__grid) {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--space-64);
    }

    .cta__action {
      justify-items: start;
    }
  }
</style>
