---
// Gastronomia: foto à esquerda e texto à direita no desktop (ritmo inverso ao de Crianças + adultos).
// No DOM o texto vem primeiro, então a ordem no mobile é texto → provas → link → foto.
// Sem JavaScript, sem texto sobre a imagem. O destino do CTA é temporário (#gastronomia).
import { Picture } from 'astro:assets';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';
import TextLink from '../ui/TextLink.astro';
import buffet from '../../assets/images/home/buffet-feijoada-salao.jpg';

const proofs = [
  {
    title: 'Preparo no próprio espaço',
    text: 'A cozinha própria permite integrar preparo, serviço e operação do evento.',
  },
  {
    title: 'Opções para diferentes ocasiões',
    text: 'Cardápios e formatos para festas, encontros familiares e eventos corporativos.',
  },
  {
    title: 'Serviço integrado',
    text: 'Gastronomia, equipe e estrutura trabalhando juntas durante a celebração.',
  },
];
---

<Section class="gastro home-section" aria-labelledby="gastronomy-title">
  <Container class="gastro__grid">
    <div class="gastro__content">
      <Eyebrow>Gastronomia</Eyebrow>
      <h2 id="gastronomy-title">Gastronomia para servir bem cada celebração</h2>
      <p class="text-large">
        O buffet faz parte da experiência no Divina Festa, com opções preparadas no próprio espaço
        e pensadas de acordo com o formato de cada evento.
      </p>

      <ul class="gastro__proofs">
        {
          proofs.map((proof) => (
            <li class="gastro__proof">
              <h3 class="gastro__proof-title">{proof.title}</h3>
              <p class="gastro__proof-text">{proof.text}</p>
            </li>
          ))
        }
      </ul>

      <TextLink href="#gastronomia">Conhecer a gastronomia</TextLink>
    </div>

    <Picture
      src={buffet}
      alt="Mesa de buffet com panelas e travessas de feijoada, arroz, farofa e laranja, e ao fundo convidados sentados nas mesas do salão e a área infantil"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={90}
      widths={[480, 720, 960, 1200, 1500]}
      sizes="(min-width: 56rem) min(45vw, 512px), (min-width: 30rem) 480px, calc(100vw - 2.5rem)"
      loading="lazy"
      class="gastro__image"
    />
  </Container>
</Section>

<style>
  .gastro :global(.gastro__grid) {
    display: grid;
    gap: var(--space-24);
  }

  .gastro__content {
    display: grid;
    justify-items: start;
    gap: var(--space-12);
  }

  .gastro__content :global(h2),
  .gastro__content p {
    margin: 0;
  }

  .gastro__content > p {
    max-width: 34rem;
  }

  .gastro__proofs {
    display: grid;
    gap: var(--space-8);
    width: 100%;
    max-width: 34rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gastro__proof {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
  }

  .gastro__proof-title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: var(--home-fact-title-size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-h4);
    letter-spacing: var(--tracking-snug);
    color: var(--color-heading);
  }

  .gastro__proof-text {
    color: var(--color-fg-muted);
  }

  /* Recorte 4:5 do original 2:3: mantém a mesa de buffet em primeiro plano e o salão ao fundo. */
  .gastro :global(.gastro__image) {
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 60%;
    border-radius: var(--radius-md);
  }

  /* Tablet em uma coluna: foto horizontal, na largura do texto, para não alongar a seção. */
  @media (min-width: 40rem) and (max-width: 55.99rem) {
    .gastro :global(.gastro__image) {
      max-width: 34rem;
      aspect-ratio: 3 / 2;
    }
  }

  /* Duas colunas só quando o texto ainda tem largura confortável (~340px+). */
  @media (min-width: 56rem) {
    .gastro :global(.gastro__grid) {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-32);
    }

    .gastro__content {
      grid-column: 2;
      grid-row: 1;
      gap: var(--space-16);
    }

    /* Foto limitada a ~512px e encostada no texto, para a seção não dominar a página. */
    .gastro :global(.gastro__image) {
      grid-column: 1;
      grid-row: 1;
      max-width: 32rem;
      justify-self: end;
    }
  }

  @media (min-width: 64rem) {
    .gastro :global(.gastro__grid) {
      grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr);
      gap: var(--space-64);
    }
  }
</style>
