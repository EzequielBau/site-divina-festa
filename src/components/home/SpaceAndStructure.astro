---
// Espaço / Estrutura: texto no topo, uma foto ampla do salão e, abaixo, seis fatos em filete.
// Sem cards, sem ícones, sem JavaScript, sem texto sobre a imagem. A foto de apoio (recepção, #48)
// saiu da Home e continua no acervo para a futura página O Espaço.
// O destino do CTA é temporário (#espaco); o id da seção também serve ao item "O Espaço" do menu.
import { Picture } from 'astro:assets';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';
import TextLink from '../ui/TextLink.astro';
import salao from '../../assets/images/home/salao-vista-ampla.png';
import { site } from '../../data/site';

// Capacidade da seção Espaço e Estrutura (DEC-017 e DEC-039): 150 sentadas; até 190 conforme a
// montagem e o uso conjunto de salão e área infantil. Não afirmar proporção de pessoas em pé.
const facts = [
  { title: '~700 m²', text: 'Salão, área infantil e ambientes de apoio integrados.' },
  {
    title: `Até ${site.capacity.seatedMax} pessoas sentadas`,
    text: 'Para eventos com mesas e lugares definidos.',
  },
  {
    title: `Até ${site.capacity.standingMax} pessoas conforme a montagem`,
    text: 'A capacidade varia conforme o formato do evento e o uso dos ambientes.',
  },
  {
    title: 'Climatização',
    text: 'Ambientes preparados para receber os convidados com conforto.',
  },
  { title: 'Estacionamento privativo', text: 'No próprio local.' },
  {
    title: 'Acessibilidade',
    text: 'Estrutura preparada para facilitar a circulação.',
  },
];
---

<Section id="espaco" class="space home-section" aria-labelledby="space-title">
  <Container class="space__inner">
    <header class="space__intro">
      <Eyebrow>O Espaço</Eyebrow>
      <h2 id="space-title">Estrutura para receber seu evento com conforto e tranquilidade</h2>
      <p class="text-large">
        São aproximadamente 700 m² com salão, área infantil e ambientes de apoio integrados para
        receber diferentes tipos de celebração.
      </p>
    </header>

    <Picture
      src={salao}
      alt="Salão do Divina Festa com mesas de madeira postas, pista ao fundo, cortinas e lustres, e amplo piso livre para circulação entre as mesas"
      formats={['avif', 'webp']}
      fallbackFormat="png"
      quality={90}
      widths={[480, 720, 960, 1200, 1672]}
      sizes="(min-width: 80rem) 1200px, calc(100vw - 2.5rem)"
      loading="lazy"
      class="space__image"
    />

    <ul class="space__facts">
      {
        facts.map((fact) => (
          <li class="space__fact">
            <h3 class="space__fact-title">{fact.title}</h3>
            <p class="space__fact-text">{fact.text}</p>
          </li>
        ))
      }
    </ul>

    <TextLink href="#espaco">Conhecer o espaço</TextLink>
  </Container>
</Section>

<style>
  .space :global(.space__inner) {
    display: grid;
    justify-items: start;
    gap: var(--space-24);
  }

  .space__intro {
    display: grid;
    justify-items: start;
    gap: var(--space-12);
  }

  .space__intro :global(h2),
  .space__intro p {
    margin: 0;
  }

  .space__intro h2 {
    max-width: 40rem;
  }

  .space__intro p {
    max-width: 42rem;
  }

  /* Foto única em 3:2, recortada do 16:9 original; mantém mesas, pista e janelas. */
  .space :global(.space__image) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: 50% 50%;
    border-radius: var(--radius-md);
  }

  .space__facts {
    display: grid;
    gap: var(--space-8) var(--space-48);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .space__fact {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding-top: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
  }

  .space__fact-title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: var(--home-fact-title-size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-h4);
    letter-spacing: var(--tracking-snug);
    color: var(--color-heading);
  }

  .space__fact-text {
    margin: 0;
    max-width: 24rem;
    color: var(--color-fg-muted);
  }

  @media (min-width: 48rem) {
    .space :global(.space__inner) {
      gap: var(--space-32);
    }

    /* Foto mais baixa que no mobile para não dominar a seção. */
    .space :global(.space__image) {
      aspect-ratio: 2 / 1;
    }

    .space__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-16) var(--space-48);
    }
  }

  @media (min-width: 64rem) {
    .space__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-24) var(--space-48);
    }
  }

  @media (min-width: 80rem) {
    .space :global(.space__image) {
      aspect-ratio: 16 / 7;
    }
  }
</style>
