---
// Como funciona: faixa editorial curta e informativa (redução de risco). Sem foto, sem cards, sem
// ícones, sem CTA, sem JavaScript. Os números são o elemento gráfico. Id #como-funciona serve ao menu.
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';

const steps = [
  {
    title: 'Conte sobre seu evento',
    text: 'Data, formato e número aproximado de convidados.',
  },
  {
    title: 'Escolha a melhor opção',
    text: 'Alinhamos as possibilidades e apresentamos a proposta.',
  },
  {
    title: 'Definimos os detalhes',
    text: 'Organizamos com você o que precisa ficar preparado.',
  },
  {
    title: 'Aproveite seu evento',
    text: 'Nossa equipe cuida da operação no dia da celebração.',
  },
];
---

<Section id="como-funciona" class="how home-section" aria-labelledby="how-title">
  <Container class="how__inner">
    <header class="how__intro">
      <Eyebrow>Como funciona</Eyebrow>
      <h2 id="how-title">Do planejamento ao dia do evento</h2>
      <p>
        Um processo simples para organizar cada etapa com mais tranquilidade.
      </p>
    </header>

    <ol class="how__steps">
      {
        steps.map((step, index) => (
          <li class="how__step">
            <span class="how__number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div class="how__body">
              <h3 class="how__title">{step.title}</h3>
              <p class="how__text">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>

<style>
  /* Faixa informativa: padding vertical local mais compacto que o das demais seções da Home. */
  section.how.home-section.section {
    padding-block: var(--space-32);
  }

  .how :global(.how__inner) {
    display: grid;
    gap: var(--space-12);
  }

  .how__intro {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .how__intro :global(h2),
  .how__intro p {
    margin: 0;
  }

  .how__intro p {
    max-width: 42rem;
  }

  .how__steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mobile: número à esquerda, texto à direita, uma linha curta por etapa. */
  .how__step {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-8);
    padding-block: 0.375rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .how__number {
    font-family: var(--font-family-heading);
    font-size: 1.625rem;
    font-weight: var(--font-weight-medium);
    line-height: 1;
    letter-spacing: var(--tracking-snug);
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--color-brown);
  }

  .how__body {
    display: grid;
    gap: 0.125rem;
  }

  .how__title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: var(--home-fact-title-size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-h4);
    letter-spacing: var(--tracking-snug);
    color: var(--color-heading);
  }

  .how__text {
    margin: 0;
    font-size: var(--font-size-small);
    line-height: 1.4;
    color: var(--color-fg-muted);
  }

  /* Tablet: 2 × 2, número acima do texto. */
  @media (min-width: 40rem) {
    section.how.home-section.section {
      padding-block: 2.5rem;
    }

    .how :global(.how__inner) {
      gap: var(--space-24);
    }

    .how__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8) var(--space-48);
    }

    .how__step {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding-block: 0.625rem 0;
    }

    .how__number {
      font-size: 2rem;
    }
  }

  /* Desktop: quatro colunas em uma única linha. */
  @media (min-width: 72rem) {
    section.how.home-section.section {
      padding-block: var(--home-section-space);
    }

    .how :global(.how__inner) {
      gap: var(--space-32);
    }

    .how__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-32);
    }

    .how__text {
      max-width: 17rem;
    }
  }
</style>
