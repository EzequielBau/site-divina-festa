---
// Cabeçalho do site. Mobile-first: menu colapsado (painel lateral) até 64rem; acima disso, navegação em linha.
// Sticky; compacta depois de um pequeno scroll. "Eventos" abre um submenu (disclosure: button + aria-expanded).
// Links são âncoras temporárias (as páginas internas ainda não existem).
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-divina-horizontal.png';
import Container from '../ui/Container.astro';
import { site } from '../../data/site';

const eventTypes = [
  { label: 'Festas infantis', href: '#festas-infantis' },
  { label: 'Eventos familiares', href: '#eventos-familiares' },
  { label: 'Festa de 15 anos', href: '#15-anos' },
  { label: 'Eventos corporativos', href: '#corporativo' },
];

const links = [
  { label: 'O Espaço', href: '#espaco' },
  { label: 'Gastronomia', href: '#gastronomia' },
  { label: 'Como funciona', href: '#como-funciona' },
];

// Exibida a 44px de altura no máximo (~173px de largura); 2x para telas densas.
const logoWidth = 346;
const logoHeight = Math.round((logoWidth * logo.height) / logo.width);
---

<header class="header">
  <Container class="bar">
    <a class="brand" href="/">
      <Image src={logo} alt={site.business.name} width={logoWidth} height={logoHeight} loading="eager" />
    </a>

    <button
      type="button"
      class="toggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <span>Menu</span>
    </button>

    <div class="scrim" aria-hidden="true"></div>

    <div class="panel" id="menu-principal">
      <div class="panel-head">
        <a class="brand" href="/" tabindex="-1" aria-hidden="true">
          <Image src={logo} alt="" width={logoWidth} height={logoHeight} loading="lazy" />
        </a>
        <button type="button" class="close" aria-label="Fechar menu">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>

      <nav aria-label="Principal">
        <ul class="links">
          <li class="has-sub">
            <button
              type="button"
              class="sub-toggle"
              aria-expanded="false"
              aria-controls="submenu-eventos"
            >
              Eventos
              <svg class="chevron" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false">
                <path d="M2.5 4.5L6 8l3.5-3.5" />
              </svg>
              <svg class="plus" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                <path class="plus-h" d="M2 8h12" />
                <path class="plus-v" d="M8 2v12" />
              </svg>
            </button>

            <div class="submenu" id="submenu-eventos">
              <ul class="sub-list" aria-label="Tipos de evento">
                {
                  eventTypes.map((item) => (
                    <li>
                      <a href={item.href}>{item.label}</a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </li>
          {
            links.map((link) => (
              <li>
                <a class="link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="place">{site.address.neighborhood} · {site.address.city}</p>
    </div>
  </Container>
</header>

<!--
  Sem JS: menu e submenu ficam visíveis (no desktop, o submenu abre por hover/foco via CSS) e o header não compacta.
  Com JS: painel lateral no mobile, submenu por clique/teclado (hover complementa no desktop) e estado compacto.
  Inline, sem arquivo extra.
-->
<script is:inline>
  (function () {
    var header = document.querySelector('.header');
    var toggle = header && header.querySelector('.toggle');
    var panel = header && header.querySelector('.panel');
    var close = header && header.querySelector('.close');
    var scrim = header && header.querySelector('.scrim');
    var sub = header && header.querySelector('.has-sub');
    var subToggle = sub && sub.querySelector('.sub-toggle');
    var submenu = sub && sub.querySelector('.submenu');
    if (!toggle || !panel || !close || !scrim || !subToggle || !submenu) return;

    var desktop = window.matchMedia('(min-width: 64rem)');
    var hover = window.matchMedia('(hover: hover) and (pointer: fine)');
    var root = document.documentElement;
    header.setAttribute('data-js', '');

    // Tudo que fica atrás do painel: o resto da página e a barra do cabeçalho.
    // Calculado na hora: este script roda antes de main e footer existirem no DOM.
    function behind() {
      var els = [].filter.call(document.body.children, function (el) {
        return el !== header && el.tagName !== 'SCRIPT';
      });
      return els.concat(header.querySelector('.bar > .brand'), toggle);
    }

    /* Painel lateral (mobile) */

    function setOpen(open, returnFocus) {
      toggle.setAttribute('aria-expanded', String(open));
      if (open) panel.setAttribute('data-open', '');
      else panel.removeAttribute('data-open');
      root.style.overflow = open ? 'hidden' : '';
      behind().forEach(function (el) {
        if (el) el.inert = open;
      });
      if (open) close.focus();
      else {
        setSub(false);
        if (returnFocus) toggle.focus();
      }
    }

    function isOpen() {
      return toggle.getAttribute('aria-expanded') === 'true';
    }

    toggle.addEventListener('click', function () {
      setOpen(true);
    });
    close.addEventListener('click', function () {
      setOpen(false, true);
    });
    scrim.addEventListener('click', function () {
      setOpen(false, true);
    });

    /* Submenu de Eventos: dropdown no desktop, acordeão no painel mobile */

    var hoverOpened = false;
    var hoverTimer = 0;

    function isSubOpen() {
      return subToggle.getAttribute('aria-expanded') === 'true';
    }

    function setSub(open) {
      clearTimeout(hoverTimer);
      hoverOpened = false;
      subToggle.setAttribute('aria-expanded', String(open));
      if (open) submenu.setAttribute('data-open', '');
      else submenu.removeAttribute('data-open');
    }

    subToggle.addEventListener('click', function () {
      // Aberto por hover: o clique confirma em vez de fechar.
      if (hoverOpened) hoverOpened = false;
      else setSub(!isSubOpen());
    });

    sub.addEventListener('mouseenter', function () {
      if (!desktop.matches || !hover.matches) return;
      clearTimeout(hoverTimer);
      if (!isSubOpen()) {
        setSub(true);
        hoverOpened = true;
      }
    });

    sub.addEventListener('mouseleave', function () {
      if (!hoverOpened) return;
      hoverTimer = setTimeout(function () {
        setSub(false);
      }, 200);
    });

    // Desktop: foco saiu do grupo (Tab) ou clique fora fecham.
    sub.addEventListener('focusout', function (event) {
      if (desktop.matches && event.relatedTarget && !sub.contains(event.relatedTarget)) setSub(false);
    });

    document.addEventListener('click', function (event) {
      if (desktop.matches && isSubOpen() && !sub.contains(event.target)) setSub(false);
    });

    /* Teclado e links */

    header.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      if (isOpen()) setOpen(false, true);
      else if (isSubOpen()) {
        setSub(false);
        subToggle.focus();
      }
    });

    panel.addEventListener('click', function (event) {
      if (!event.target.closest || !event.target.closest('nav a')) return;
      if (isOpen()) setOpen(false);
      else setSub(false);
    });

    desktop.addEventListener('change', function () {
      if (isOpen()) setOpen(false);
      setSub(false);
    });

    /* Estado compacto: um sentinela no topo da página, sem listener de scroll. */

    if ('IntersectionObserver' in window) {
      var sentinel = document.createElement('div');
      sentinel.setAttribute('aria-hidden', 'true');
      sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:24px;pointer-events:none;visibility:hidden';
      document.body.prepend(sentinel);
      new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) header.removeAttribute('data-compact');
        else header.setAttribute('data-compact', '');
      }).observe(sentinel);
    }
  })();
</script>

<style>
  .header {
    /* Altura da barra: confortável no topo, compacta após scroll. */
    --bar-h: 4rem; /* 64px */
    --bar-h-compact: 3.5rem; /* 56px */
    --bar-now: var(--bar-h);
    --logo-h: 2.25rem; /* 36px */
    --logo-h-compact: 2rem; /* 32px */
    --logo-now: var(--logo-h);

    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--color-white);
    border-bottom: var(--border-width) solid var(--color-border);
    transition:
      margin-bottom var(--motion-duration) var(--motion-ease),
      box-shadow var(--motion-duration) var(--motion-ease);
  }

  /* A margem compensa a redução da barra: o conteúdo abaixo não salta. */
  .header[data-compact] {
    --bar-now: var(--bar-h-compact);
    --logo-now: var(--logo-h-compact);
    margin-bottom: calc(var(--bar-h) - var(--bar-h-compact));
    box-shadow: var(--shadow-float);
  }

  .header :global(.bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    min-height: var(--bar-now);
    transition: min-height var(--motion-duration) var(--motion-ease);
  }

  .brand {
    display: block;
    flex: none;
    border-radius: var(--radius-sm);
  }

  .brand img {
    width: auto;
    height: var(--logo-now);
    transition: height var(--motion-duration) var(--motion-ease);
  }

  /* Botão de menu: só existe com JS. Neutro e leve, para pesar menos que o logo. */
  .toggle {
    display: none;
    align-items: center;
    gap: var(--space-8);
    min-height: 44px;
    padding: 0 var(--space-12);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-fg);
    font-family: var(--font-family-body);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: background-color var(--motion-duration) var(--motion-ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .toggle:hover {
      background: var(--color-cream);
    }
  }

  .toggle svg,
  .close svg,
  .sub-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .header[data-js] .toggle {
    display: inline-flex;
  }

  /* Sem JS: painel em fluxo, abaixo da barra. Elementos de drawer ficam ocultos. */
  .panel {
    flex-basis: 100%;
    padding-bottom: var(--space-24);
  }

  .panel-head,
  .close,
  .place,
  .scrim {
    display: none;
  }

  .links,
  .sub-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link,
  .sub-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    color: var(--color-heading);
    white-space: nowrap;
    font-family: var(--font-family-body);
    font-size: var(--font-size-large);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .sub-toggle {
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    line-height: inherit;
    text-align: left;
    cursor: pointer;
  }

  .chevron,
  .plus {
    flex: none;
    color: var(--color-brown);
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  .chevron {
    display: none;
  }

  .header:not([data-js]) .plus {
    display: none;
  }

  .plus-v {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  .sub-toggle[aria-expanded='true'] .plus-v {
    transform: scaleY(0);
  }

  .sub-list a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
    color: var(--color-heading);
    font-size: var(--font-size-body);
    line-height: var(--line-height-small);
    text-decoration: none;
  }

  /* Mobile/tablet com JS: painel lateral vindo da direita. */
  @media (max-width: 63.9375rem) {
    .submenu {
      padding: 0 0 var(--space-12) var(--space-16);
    }

    .header[data-js] .submenu:not([data-open]) {
      display: none;
    }

    .header[data-js] .scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 40;
      background: rgb(40 33 32 / 0.45);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--motion-duration) var(--motion-ease),
        visibility 0s linear var(--motion-duration);
    }

    .header[data-js]:has(.panel[data-open]) .scrim {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }

    .header[data-js] .panel {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      display: flex;
      flex-direction: column;
      width: min(92vw, 26rem);
      height: 100dvh;
      padding: 0 var(--space-24) var(--space-24);
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--color-cream); /* fallback sólido */
      border-left: var(--border-width) solid var(--color-border);
      border-radius: 20px 0 0 20px;
      box-shadow: -8px 0 48px rgb(40 33 32 / 0.14);
      transform: translateX(100%);
      visibility: hidden;
      transition:
        transform var(--motion-duration) var(--motion-ease),
        visibility 0s linear var(--motion-duration);
    }

    @supports (backdrop-filter: blur(1px)) {
      .header[data-js] .panel {
        background: color-mix(in srgb, var(--color-cream) 95%, transparent);
        backdrop-filter: blur(12px);
      }
    }

    .header[data-js] .panel[data-open] {
      transform: none;
      visibility: visible;
      transition-delay: 0s;
    }

    .header[data-js] .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex: none;
      min-height: 4rem; /* mesma altura da barra no topo: logo na mesma escala */
    }

    .header[data-js] .panel-head img {
      height: var(--logo-h);
    }

    .header[data-js] .close {
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      padding: 0;
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--radius-md);
      background: transparent;
      color: var(--color-fg);
      cursor: pointer;
      transition: background-color var(--motion-duration) var(--motion-ease);
    }

    .header[data-js] .close svg {
      width: 22px;
      height: 22px;
    }

    @media (hover: hover) and (pointer: fine) {
      .header[data-js] .close:hover {
        background: var(--color-white);
      }
    }

    .header[data-js] nav {
      flex: 1;
      padding-top: var(--space-24);
    }

    .header[data-js] .link,
    .header[data-js] .sub-toggle {
      min-height: 56px;
      margin-inline: calc(-1 * var(--space-12));
      padding-inline: var(--space-12);
      border-radius: var(--radius-md);
      transition: background-color var(--motion-duration) var(--motion-ease);
    }

    .header[data-js] .sub-toggle {
      width: calc(100% + 2 * var(--space-12));
    }

    /* Indicação mínima de direção. */
    .header[data-js] .link::after {
      content: '';
      width: 0.5rem;
      height: 0.5rem;
      border-top: 1.5px solid var(--color-brown);
      border-right: 1.5px solid var(--color-brown);
      transform: rotate(45deg);
      opacity: 0.7;
    }

    .header[data-js] .link:active,
    .header[data-js] .sub-toggle:active,
    .header[data-js] .sub-list a:active {
      background: var(--color-cream-alt);
    }

    .header[data-js] .sub-list a {
      margin-inline: calc(-1 * var(--space-12));
      padding-inline: var(--space-12);
      border-radius: var(--radius-md);
    }

    @media (hover: hover) and (pointer: fine) {
      .header[data-js] .link:hover,
      .header[data-js] .sub-toggle:hover,
      .header[data-js] .sub-list a:hover {
        background: var(--color-cream-alt);
      }
    }

    .header[data-js] .place {
      display: block;
      flex: none;
      margin: var(--space-24) 0 0;
      color: var(--color-fg-muted);
      font-size: var(--font-size-small);
      line-height: var(--line-height-small);
      text-align: left;
    }
  }

  @media (min-width: 64rem) {
    .header {
      --bar-h: 5rem; /* 80px */
      --bar-h-compact: 4rem; /* 64px */
      --logo-h: 2.75rem; /* 44px */
      --logo-h-compact: 2.25rem; /* 36px */
    }

    .header :global(.bar) {
      flex-wrap: nowrap;
      gap: var(--space-32);
    }

    /* Nada do painel mobile pode aparecer no desktop. */
    .header .toggle,
    .header .scrim,
    .header .panel-head,
    .header .close,
    .header .place,
    .header .plus {
      display: none !important;
    }

    .header .panel {
      position: static;
      visibility: visible;
      transform: none;
      overflow: visible;
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: flex-end;
      gap: var(--space-32);
      padding: 0;
    }

    .links {
      display: flex;
      align-items: center;
      gap: var(--space-32);
    }

    .link,
    .sub-toggle {
      min-height: 48px;
      font-size: var(--font-size-body);
    }

    .sub-toggle {
      justify-content: flex-start;
      gap: var(--space-8);
      width: auto;
    }

    .chevron {
      display: block;
    }

    .sub-toggle[aria-expanded='true'] .chevron {
      transform: rotate(180deg);
    }

    @media (hover: hover) and (pointer: fine) {
      .link:hover,
      .sub-toggle:hover {
        text-decoration: underline;
        text-decoration-color: var(--color-gold);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.3em;
      }
    }

    /* Dropdown: alinhado ao texto de "Eventos", encostado na borda inferior do header. */
    .has-sub {
      position: relative;
    }

    .submenu {
      position: absolute;
      top: calc(100% + (var(--bar-now) - 48px) / 2 + var(--space-8));
      left: calc(-1 * (var(--space-8) + var(--space-12) + var(--border-width))); /* texto dos itens alinhado ao de Eventos */
      width: 17.5rem; /* 280px */
      padding: var(--space-8);
      background: var(--color-white);
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow:
        var(--shadow-float),
        0 16px 40px rgb(40 33 32 / 0.08);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transition:
        opacity var(--motion-duration) var(--motion-ease),
        transform var(--motion-duration) var(--motion-ease),
        visibility 0s linear var(--motion-duration);
    }

    /* Ponte invisível sobre o vão: o hover não se perde no caminho até o painel. */
    .submenu::before {
      content: '';
      position: absolute;
      right: 0;
      bottom: 100%;
      left: 0;
      height: calc((var(--bar-now) - 48px) / 2 + var(--space-8) + 2px);
    }

    .submenu[data-open],
    .header:not([data-js]) .has-sub:is(:hover, :focus-within) .submenu {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .sub-list a {
      padding: var(--space-8) var(--space-12);
      border-radius: var(--radius-md);
      transition: background-color var(--motion-duration) var(--motion-ease);
    }

    @media (hover: hover) and (pointer: fine) {
      .sub-list a:hover {
        background: var(--color-cream-alt);
      }
    }

    .sub-list a:focus-visible {
      outline-offset: -2px;
    }
  }
</style>
