---
// Rodapé institucional: faixa final discreta, sem CTA comercial nem canais de contato (o contato fica nas páginas e no botão flutuante).
// Perfis sociais ficam de fora até haver URL oficial aprovada (L-13). O link "Ver no Google Maps"
// vem de site.address.mapsUrl (provisório até a URL oficial do perfil).
// Ordem do DOM = ordem mobile: marca → navegação → endereço → copyright. Zero JavaScript.
// Desktop: marca + texto | navegação em linha; divisor; endereço | copyright.
// Links são âncoras temporárias (as páginas internas ainda não existem).
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-divina-stacked.png';
import Container from '../ui/Container.astro';
import { site } from '../../data/site';

const links = [
  { label: 'Eventos', href: '#eventos' },
  { label: 'O Espaço', href: '#espaco' },
  { label: 'Gastronomia', href: '#gastronomia' },
  { label: 'Contato', href: '#contato' },
];

const { address } = site;
const year = new Date().getFullYear();

// Exibida a 48px de altura no máximo (~73px de largura); 2x para telas densas.
const logoWidth = 146;
const logoHeight = Math.round((logoWidth * logo.height) / logo.width);
---

<footer class="footer">
  <Container>
    <div class="top">
      <div class="brand-block">
        <a class="brand" href="/">
          <Image src={logo} alt={site.business.name} width={logoWidth} height={logoHeight} loading="lazy" />
        </a>
        <div class="about">
          <p class="statement">Espaço de eventos e buffet em {address.city}.</p>
          <p class="support">
            Estrutura, gastronomia e organização para diferentes momentos de celebração.
          </p>
        </div>
      </div>

      <nav class="nav" aria-label="Rodapé">
        <ul class="links">
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="bottom">
      <address class="place">
        {address.street}, {address.number} · {address.neighborhood} · {address.city}/{address.state}
        <span class="sep" aria-hidden="true"> · </span>
        <br class="br" />
        <a class="maps" href={address.mapsUrl} target="_blank" rel="noopener">Ver no Google Maps</a>
      </address>
      <p class="copyright">© {year} {site.business.name}</p>
    </div>
  </Container>
</footer>

<style>
  /* Mesmos papéis de cor de Section tone="dark": descendentes herdam o contraste. */
  .footer {
    --color-bg: var(--color-ink-strong);
    --color-fg: var(--color-cream);
    --color-fg-muted: color-mix(in srgb, var(--color-cream) 72%, var(--color-ink-strong));
    --color-heading: var(--color-white);
    --color-link: var(--color-cream);
    --color-border: color-mix(in srgb, var(--color-cream) 16%, var(--color-ink-strong));
    --color-focus: var(--color-cream);

    padding-block: var(--space-24) var(--space-16);
    background: var(--color-bg);
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-fg);
  }

  .top {
    display: grid;
    gap: var(--space-8);
  }

  .brand-block {
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }

  .brand {
    display: block;
    flex: none;
    border-radius: var(--radius-sm);
  }

  .brand img {
    width: auto;
    height: 3rem; /* 48px */
  }

  .statement {
    color: var(--color-heading);
    font-family: var(--font-family-heading);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-small);
    text-wrap: balance;
  }

  .support {
    margin-top: var(--space-4);
    color: var(--color-fg-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  /* Mobile: duas colunas; cada item mantém 44px de toque. */
  .links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--font-size-small);
    white-space: nowrap;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover {
      text-decoration: underline;
      text-decoration-color: var(--color-gold);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.3em;
    }
  }

  .bottom {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-12);
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-fg-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .place {
    font-style: normal;
  }

  /* Reserva a área do botão flutuante (canto inferior direito) para ele não cobrir endereço e copyright. */
  .bottom {
    padding-right: 4.75rem;
  }

  @media (min-width: 48rem) {
    .bottom {
      padding-right: 10.5rem;
    }
  }

  /* Mobile: o link fica em linha própria, sem o separador sobrando no fim da linha anterior. */
  .sep {
    display: none;
  }

  @media (min-width: 48rem) {
    .sep {
      display: inline;
    }

    .br {
      display: none;
    }
  }

  .maps {
    display: inline-block;
    padding-block: var(--space-8);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (hover: hover) and (pointer: fine) {
    .maps:hover {
      text-decoration-color: var(--color-gold);
      text-decoration-thickness: 2px;
    }
  }

  /* Tablet em diante: marca e navegação na mesma linha. */
  @media (min-width: 48rem) {
    .top {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--space-48);
    }

    .brand-block {
      gap: var(--space-24);
    }

    .links {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--space-24);
    }

    .links a {
      min-height: 40px;
    }

    .bottom {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      column-gap: var(--space-32);
    }
  }

  @media (min-width: 64rem) {
    .footer {
      padding-block: var(--space-24) var(--space-12);
    }

    .links a {
      min-height: 36px;
    }
  }
</style>
