---
// Botão de ação. Renderiza <a> quando há href; caso contrário, <button type="button">.
import type { HTMLAttributes } from 'astro/types';

type Props = { variant?: 'primary' | 'secondary' } & (
  | (HTMLAttributes<'a'> & { href: string })
  | (HTMLAttributes<'button'> & { href?: undefined })
);

const { variant = 'primary', class: className, ...attrs } = Astro.props;
const classes = ['button', `button--${variant}`, className];
---

{
  attrs.href !== undefined ? (
    <a class:list={classes} {...(attrs as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={classes} {...(attrs as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    min-height: 48px;
    padding: var(--space-12) 22px;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-md);
    font-family: var(--font-family-body);
    font-size: var(--font-size-button);
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .button:active {
    transform: translateY(1px);
  }

  .button--primary {
    background: var(--color-action-bg);
    color: var(--color-action-fg);
  }

  .button--primary:hover {
    background: var(--color-action-bg-hover);
  }

  .button--secondary {
    background: transparent;
    border-color: var(--color-heading);
    color: var(--color-heading);
  }

  .button--secondary:hover {
    background: color-mix(in srgb, var(--color-heading) 6%, transparent);
  }
</style>
