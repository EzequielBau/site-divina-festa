---
// Botão de ação. Renderiza <a> quando há href; caso contrário, <button type="button">.
import type { HTMLAttributes } from 'astro/types';

type Props = { variant?: 'primary' | 'secondary' | 'outline' } & (
  | (HTMLAttributes<'a'> & { href: string })
  | (HTMLAttributes<'button'> & { href?: undefined })
);

const { variant = 'primary', class: className, ...attrs } = Astro.props;
const classes = ['button', `button--${variant}`, className];
---

{
  attrs.href !== undefined ? (
    <a class:list={classes} {...(attrs as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={classes} {...(attrs as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}

<style>
  /* Referência: botões do site anterior (Kadence), adaptados ao contraste AA.
     Sem sombra; hover só com mouse; active e focus valem em qualquer dispositivo. */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    min-height: 48px;
    padding: 14px 26px;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-button);
    font-family: var(--font-family-heading);
    font-size: var(--font-size-button);
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .button:active {
    transform: translateY(1px);
  }

  /* Principal: dourado + texto escuro; hover em dourado escuro + texto branco. */
  .button--primary {
    background: var(--color-action-bg);
    color: var(--color-action-fg);
  }

  /* Secundário: branco com borda dourada suave; hover em creme com borda dourada. */
  .button--secondary {
    background: var(--color-white);
    border-color: var(--color-gold-soft);
    color: var(--color-brown);
  }

  /* Outline: só contorno dourado; hover preenche de dourado (texto escuro, 4,99:1).
     Para fundos claros. */
  .button--outline {
    padding: 13px 24px;
    background: transparent;
    border-color: var(--color-gold);
    color: var(--color-brown);
    font-size: 0.9375rem; /* 15px */
  }

  @media (hover: hover) and (pointer: fine) {
    .button--primary:hover {
      background: var(--color-action-bg-hover);
      color: var(--color-action-fg-hover);
    }

    .button--secondary:hover {
      background: var(--color-cream-alt);
      border-color: var(--color-gold);
      color: var(--color-ink-strong);
    }

    .button--outline:hover {
      background: var(--color-gold);
      color: var(--color-ink-strong);
    }
  }

  /* Clicado: um tom além do hover, para o toque também ter retorno visual. */
  .button--primary:active {
    background: color-mix(in srgb, var(--color-gold-dark) 85%, var(--color-ink-strong));
    color: var(--color-action-fg-hover);
  }

  .button--secondary:active {
    background: color-mix(in srgb, var(--color-cream-alt) 70%, var(--color-gold-soft));
    border-color: var(--color-gold);
    color: var(--color-ink-strong);
  }

  /* Escurecer o dourado derrubaria o contraste do texto escuro abaixo de 4,5:1. */
  .button--outline:active {
    background: var(--color-gold);
    color: var(--color-ink-strong);
  }
</style>